# ==========================================
# TechCompare Root Environment Example
# See backend/.env.example and frontend/.env.example
# DO NOT put real credentials in this file.
# ==========================================

# Backend Server
PORT=4000
NODE_ENV=development

# TechSpecs API v5 (Backend Only - Never expose to Frontend)
TECHSPECS_API_ID=your_techspecs_api_id_here
TECHSPECS_API_KEY=your_techspecs_api_key_here

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
